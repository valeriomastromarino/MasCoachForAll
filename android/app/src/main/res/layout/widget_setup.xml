<?xml version="1.0" encoding="utf-8"?>
<!-- Widget with no data yet (also the first layout the launcher shows): open MasCoach, which gives it the day. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_hero_full"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/w_logo" />

        <TextView
            style="@style/WLogo"
            android:layout_marginStart="6dp" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="9dp"
            android:layout_marginStart="1dp"
            android:contentDescription="@null"
            android:src="@drawable/w_cursor" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_setup_title"
        style="@style/WHeadline"
        android:layout_marginTop="8dp"
        android:text="Apri MasCoach" />

    <TextView
        android:id="@+id/w_setup_text"
        style="@style/WHeroSmall"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:textSize="13sp"
        android:text="Il widget prende la giornata dall’app." />
</LinearLayout>
