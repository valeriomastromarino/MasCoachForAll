<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «B + C», mini 2×2 (from 110 × 160 dp): verdict, bar and two numbers on the card; under it the session. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/w_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/w_hero"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="12dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/w_logo" />

            <TextView
                style="@style/WLogo"
                android:layout_marginStart="6dp" />

            <ImageView
                android:layout_width="5dp"
                android:layout_height="9dp"
                android:layout_marginStart="1dp"
                android:contentDescription="@null"
                android:src="@drawable/w_cursor" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_word"
            style="@style/WHeadline"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal"
            android:layout_marginTop="7dp">

            <ImageView
                android:id="@+id/w_seg0"
                style="@style/WSeg"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/w_seg1"
                style="@style/WSeg"
                android:layout_marginStart="3dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/w_seg2"
                style="@style/WSeg"
                android:layout_marginStart="3dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_nums"
            style="@style/WHeroSmall"
            android:layout_width="match_parent"
            android:layout_marginTop="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_session"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="9dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/w_lab"
            style="@style/WLab" />

        <TextView
            android:id="@+id/w_lab_prop"
            style="@style/WLab"
            android:textColor="@color/w_a_ink"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_lab_done"
            style="@style/WLab"
            android:textColor="@color/w_good_ink"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_title"
            style="@style/WTitle"
            android:maxLines="2"
            android:textSize="13.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_meta"
                style="@style/WLab"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/w_meta_warn"
                style="@style/WLab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/w_warn_ink"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_act_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/w_btn_round_main"
                android:contentDescription="Pedala"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w_ic_play"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_act_go"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/w_btn_round"
                android:contentDescription="Apri"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w_ic_right" />

            <ImageView
                android:id="@+id/w_act_cal"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/w_btn_round"
                android:contentDescription="Piano"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/w_ic_calendar"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
