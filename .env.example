# Copia questo file in .env.local e inserisci i tuoi dati.
# Intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=
# Il tuo ID atleta (es. i123456). "0" = l'atleta proprietario della chiave.
INTERVALS_ATHLETE_ID=0
# Solo per la versione online (Vercel): password per entrare. Senza, su Vercel l'app resta bloccata.
APP_PASSWORD=
# Solo online: segreto (almeno 24 caratteri) nell'indirizzo del connettore per Claude, https://…/api/mcp/<segreto>.
MCP_SECRET=
