# Copia questo file in .env.local e inserisci i tuoi dati.
# Intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=
# Il tuo ID atleta (es. i123456). "0" = l'atleta proprietario della chiave.
INTERVALS_ATHLETE_ID=0
# Solo per la versione online (Vercel): password per entrare. Senza, su Vercel l'app resta bloccata.
APP_PASSWORD=
# Solo online: segreto (almeno 24 caratteri) nell'indirizzo del connettore per Claude, https://…/api/mcp/<segreto>.
MCP_SECRET=

# Chiave Anthropic per il coach scritto (solo versione online; senza, la chat usa le regole)
ANTHROPIC_API_KEY=

# Facoltativo: il fuso orario dell'atleta, per il giorno di "oggi" sul server (Vercel conta in UTC). Default Europe/Rome.
# APP_TIMEZONE=Europe/Rome

# Facoltativo: le sedute dei rulli anche su Strava. Crea l'app su https://www.strava.com/settings/api (serve l'abbonamento
# Strava) con "Authorization Callback Domain" = il dominio del sito, poi metti qui (o su Vercel) le due chiavi.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
